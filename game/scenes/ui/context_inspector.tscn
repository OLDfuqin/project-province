[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/ui/context_inspector.gd" id="1_inspector"]
[ext_resource type="Theme" path="res://themes/strategic_ui_theme.tres" id="2_theme"]

[node name="ContextInspector" type="PanelContainer"]
custom_minimum_size = Vector2(300, 0)
layout_mode = 2
size_flags_vertical = 3
theme = ExtResource("2_theme")
script = ExtResource("1_inspector")

[node name="Body" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Header" type="HBoxContainer" parent="Body"]
layout_mode = 2

[node name="Title" type="Label" parent="Body/Header"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 20
text = "战略信息"

[node name="Close" type="Button" parent="Body/Header"]
unique_name_in_owner = true
custom_minimum_size = Vector2(32, 32)
layout_mode = 2
text = "×"
tooltip_text = "关闭信息面板"

[node name="ScrollContainer" type="ScrollContainer" parent="Body"]
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="Content" type="VBoxContainer" parent="Body/ScrollContainer"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3

[node name="Empty" type="Label" parent="Body/ScrollContainer/Content"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
text = "请选择地区或军队"
horizontal_alignment = 1
vertical_alignment = 1
autowrap_mode = 2
